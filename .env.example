# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# Which profile the containerised API runs with: local | dev | prod
SPRING_PROFILES_ACTIVE=dev

# Port the API is published on
SERVER_PORT=8080

# Database — these defaults match docker-compose and are development-only values
DB_NAME=fin_dashboard
DB_USERNAME=dashboard
DB_PASSWORD=dashboard
DB_PORT=5432

# The prod profile requires a full JDBC URL and has no fallback, so a missing value
# stops startup instead of silently using a development database:
# DB_URL=jdbc:postgresql://db.example.com:5432/fin_dashboard

# Market data — how long to wait on the Yahoo Finance call before giving up
QUOTES_TIMEOUT_MS=10000

# Realtime feed — how often subscribed quotes are fetched and pushed over WebSocket
QUOTES_STREAM_INTERVAL_MS=3000

# Origin patterns allowed to open a WebSocket connection (comma-separated; * allows any)
QUOTES_STREAM_ALLOWED_ORIGINS=*
