{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw verify)",
      "Bash(./mvnw test)",
      "Bash(./mvnw compile)",
      "Bash(./mvnw clean:*)",
      "Bash(./mvnw spotless:apply)",
      "Bash(./mvnw spotless:check)",
      "Bash(./mvnw checkstyle:check)",
      "Bash(./mvnw spotbugs:check)",
      "Bash(./mvnw dependency:tree)",
      "Bash(mvn verify)",
      "Bash(mvn test)",
      "Bash(mvn spotless:apply)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose down:*)",
      "Bash(docker ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(curl -s http://localhost:8080/:*)",
      "Bash(curl -sS http://localhost:8080/:*)"
    ]
  }
}
