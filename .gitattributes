# Normalise line endings so Windows checkouts and Linux CI see identical bytes.
# Spotless is configured with <lineEndings>UNIX</lineEndings> to match.
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
Dockerfile text eol=lf
*.sh     text eol=lf

# Binary
*.jar    binary
*.png    binary
*.jpg    binary
