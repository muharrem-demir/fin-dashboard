# Build output — the image builds from source, never from a local target/
target/
**/target/

# VCS and CI
.git/
.gitignore
.gitattributes
.github/

# IDE
.idea/
.vscode/
*.iml
.settings/
.classpath
.project

# Docs and local tooling
*.md
!README.md
.claude/
docs/

